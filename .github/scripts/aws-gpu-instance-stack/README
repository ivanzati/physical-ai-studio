# NOTE: pass the SAME region to every command. The VpcId/SubnetId in the ids
# file are region-specific, so deploy/teardown must target the region the VPC was
# created in. Without a region the AWS CLI's configured default is used, which may
# differ and cause failures or act on the wrong region's resources.

# 0. Set region/profile once — both scripts honor these env vars, so every
#    command below reuses the same region and profile.
export AWS_REGION=us-east-2
export AWS_PROFILE=<your-aws-profile>

# 1. Create shared networking once
./create-vpc.sh up --name gpu-net

# 2. Launch machines — one unique --stack per machine (can run concurrently)
./deploy-stack.sh up --stack gpu-01 --ids-file gpu-net.ids.env
./deploy-stack.sh up --stack gpu-02 --ids-file gpu-net.ids.env

# 2a. SSH into a machine.
#  The private key is generated by CloudFormation and stored in SSM Parameter Store.
#  'deploy-stack.sh up' prints an "SSHCommand" output that does all of the below;
#  copy/paste it, or run these steps manually (STACK is the --stack name you used):
STACK=gpu-01
KEY_PATH=$(aws cloudformation describe-stacks --stack-name "$STACK" \
  --query "Stacks[0].Outputs[?OutputKey=='SSHKeyParameterStorePath'].OutputValue" --output text)
IP=$(aws cloudformation describe-stacks --stack-name "$STACK" \
  --query "Stacks[0].Outputs[?OutputKey=='InstancePublicIP'].OutputValue" --output text)
# Fetch the private key, lock down its permissions, then connect as 'ubuntu'.
aws ssm get-parameter --name "$KEY_PATH" --with-decryption \
  --query Parameter.Value --output text > "$STACK-key.pem"
chmod 600 "$STACK-key.pem"
ssh -i "$STACK-key.pem" ubuntu@"$IP"
#  Note: SSH (port 22) is restricted to Intel network ranges; connect from the Intel network/VPN.
#  Verify the GPU once connected:  nvidia-smi

# 3. Tear down individual machines
./deploy-stack.sh down --stack gpu-01

# 4. Remove networking when all stacks are gone
./create-vpc.sh down --ids-file gpu-net.ids.env
